          "additionalProperties": false,
          "required": [
            "thought_id"
          ],
          "properties": {
            "thought_id": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "neurotrace_host",
        "toolReferenceName": "neurotrace_host",
        "displayName": "NeuroTrace: host",
        "modelDescription": "Only on an explicit hosting/setup request: start a local NeuroTrace server, verify an administrator-provided HTTPS tunnel URL, or setup a new network/project and return an invitation. Never creates a tunnel or changes Cloudflare. publish_existing requires explicit authorization to share this workspace. No credentials are returned.",
        "userDescription": "Only on an explicit hosting/setup request: start a local NeuroTrace server, verify an administrator-provided HTTPS tunnel URL, or setup a new network/project and return an invitation. Never creates a tunnel or changes Cloudflare. publish_existing requires explicit authorization to share this workspace. No credentials are returned.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "status",
                "start",
                "verify",
                "setup",
                "stop"
              ],
              "default": "status"
            },
            "port": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535,
              "default": 9473
            },
            "public_url": {
              "type": "string"
            },
            "network_name": {
              "type": "string"
            },
            "project_name": {
              "type": "string"
            },
            "owner_name": {
              "type": "string"
            },
            "invite_name": {
              "type": "string"
            },
            "invite_role": {
              "type": "string",
              "enum": [
                "viewer",
                "editor",
                "admin"
              ],
              "default": "editor"
            },
            "publish_existing": {
              "type": "boolean",
              "default": false
            },
            "confirm_legacy_repository": {
              "type": "boolean",
              "default": false,
              "description": "Only after explicit confirmation that legacy local memories belong to the observed Git repository."
            }
          }
        }
      },
      {
        "name": "neurotrace_connect",
        "toolReferenceName": "neurotrace_connect",
        "displayName": "NeuroTrace: connect",
        "modelDescription": "Only when asked to connect shared memory: join using an invitation URL or claim a new cloud server using a private local setup_key_file. Secrets stay out of chat. Explicit publish_existing imports local memories with a logical backup and preserves differing same-ID versions under new IDs.",
        "userDescription": "Only when asked to connect shared memory: join using an invitation URL or claim a new cloud server using a private local setup_key_file. Secrets stay out of chat. Explicit publish_existing imports local memories with a logical backup and preserves differing same-ID versions under new IDs.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "invitation_url": {
              "type": "string"
            },
            "server_url": {
              "type": "string"
            },
            "setup_key_file": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "network_name": {
              "type": "string"
            },
            "project_name": {
              "type": "string"
            },
            "publish_existing": {
              "type": "boolean",
              "default": false
            },
            "confirm_legacy_repository": {
              "type": "boolean",
              "default": false,
              "description": "Only after explicit confirmation that legacy local memories belong to the observed Git repository."
            },
            "preview_only": {
              "type": "boolean",
              "default": false,
              "description": "Validate invitation and local repository without consuming the invitation or exchanging memories."
            },
            "path_policy": {
              "type": "string",
              "enum": [
                "reject",
                "remap",
                "detach"
              ],
              "default": "reject",
              "description": "Explicit legacy path policy: reject outside paths; remap existing repository suffixes; or retain the original code reference in text."
            },
            "type_map": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Explicit mapping from legacy types to supported memory types, for example finding to insight."
            }
          }
        }
      },
      {
        "name": "neurotrace_team",
        "toolReferenceName": "neurotrace_team",
        "displayName": "NeuroTrace: team",
        "modelDescription": "Manage team membership only on explicit user request. Inspect members, create single-use invitation links for humans/agents/devices, change roles, remove members or transfer project ownership. Server role checks remain authoritative.",
        "userDescription": "Manage team membership only on explicit user request. Inspect members, create single-use invitation links for humans/agents/devices, change roles, remove members or transfer project ownership. Server role checks remain authoritative.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
