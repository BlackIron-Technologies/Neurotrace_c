      {
        "name": "neurotrace_sync",
        "toolReferenceName": "neurotrace_sync",
        "displayName": "NeuroTrace: Sync Status and Delivery",
        "modelDescription": "Inspect automatic synchronization or wait for confirmed delivery before a shared-work handoff. retry wakes the worker without resuming a user pause or changing credentials, server or permissions. A device receipt means applied locally, not read by a human.",
        "userDescription": "Inspect automatic synchronization or wait for confirmed delivery before a shared-work handoff. retry wakes the worker without resuming a user pause or changing credentials, server or permissions. A device receipt means applied locally, not read by a human.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "status",
                "wait",
                "retry"
              ],
              "default": "status"
            },
            "thought_id": {
              "type": "string",
              "description": "Optional memory ID to inspect or wait for."
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30000,
              "default": 10000
            },
            "wait_for_peers": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "default": 0,
              "description": "Other devices required to report applying the checkpoint. Offline devices may cause timeout."
            }
          }
        }
      },
      {
        "name": "neurotrace_getThought",
        "toolReferenceName": "neurotrace_getThought",
        "displayName": "NeuroTrace: Get Memory by ID",
        "modelDescription": "Read one memory by ID, its base_text and sync delivery state. Use base_text when editing shared text to preserve concurrent changes. Prefer this over scanning pages when the ID is known.",
        "userDescription": "Read one memory by ID, its base_text and sync delivery state. Use base_text when editing shared text to preserve concurrent changes. Prefer this over scanning pages when the ID is known.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
