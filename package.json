    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-python": "python -m compileall -q bin compilation/neurotrace.py",
    "check-onnx": "python compilation/smoke-onnx-model.py",
    "compile-tests": "npm run compile",
    "watch-tests": "tsc --noEmit --watch --project tsconfig.json",
    "pretest": "npm run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "npm run check-python && npm run check-onnx && npm run test:backend-install",
    "test:sync": "python -m unittest discover -s tests -p 'test_sync*.py' -v",
    "test:backend-install": "node tests/check_backend_install.cjs"
